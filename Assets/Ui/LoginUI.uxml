<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; -unity-font-definition: url(&quot;project://database/Assets/Import/Manrope-Medium.ttf?fileID=12800000&amp;guid=c824965482ba0440d95df186b7151eb9&amp;type=3#Manrope-Medium&quot;); align-self: auto; justify-content: center; font-size: 27px; align-items: center; background-image: url(&quot;project://database/Assets/Import/New%20Render%20Texture.renderTexture?fileID=8400000&amp;guid=4696df3b2eb8e40dbba5e2ff5e047ddc&amp;type=2#New Render Texture&quot;); -unity-background-scale-mode: scale-and-crop;">
        <ui:VisualElement name="AuthForm" style="flex-grow: 1; left: auto; right: auto; position: absolute; top: auto; bottom: auto; width: 740px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; background-color: rgba(0, 0, 0, 0.42); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; color: rgb(255, 255, 255); visibility: visible;">
